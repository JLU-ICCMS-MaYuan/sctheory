# Claudian local state can contain prompts, file contents, and credentials.
.claudian/claudian-settings.json
.claudian/sessions/
.claudian/opencode/

# Local application state is recreated for each Obsidian installation.
.codex
.obsidian/

# Journal directories already use tracked .workplaner-keep placeholders.
Journal/Daily/
Journal/Monthly/
Journal/Quarterly/
Journal/Weekly/
Journal/Yearly/

# Research source PDFs and generated raster evidence stay local.
Knowledge/.generation-state.json
Knowledge/Sources/
Knowledge/Extracted/
Knowledge/Articles/
Knowledge/Wiki/

Research/

# Generated caches and disposable local validation output.
**/__pycache__/
*.py[cod]
tmp/
.vscode/
.venv/
