       RowBox[{"{", 
        RowBox[{"0.5", ",", "0.5", ",", "0.5"}], "}"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"labels", "=", 
    RowBox[{"{", 
     RowBox[{
     "\"\<G\>\"", ",", "\"\<X\>\"", ",", "\"\<M\>\"", ",", "\"\<G\>\"", ",", 
      "\"\<R\>\""}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"G", "-", "X", "-", "M", "-", "G", "-", "R"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"segments", "=", "40"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kPath", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"pathPoints", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"pathPoints", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
               RowBox[{"pathPoints", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "t"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"1", "-", 
              RowBox[{"1", "/", "segments"}]}], ",", 
             RowBox[{"1", "/", "segments"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{
            RowBox[{"Length", "[", "pathPoints", "]"}], "-", "1"}]}], "}"}]}],
         "]"}], ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"kPath", ",", 
      RowBox[{"Last", "[", "pathPoints", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:6b63\:5728\:8ba1\:7b97\:80fd\:5e26...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"energyData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"Ham", "[", "k", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "kPath"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nElectrons", "=", "10"}], ";"}], "\n", 
   RowBox[{"vbm", "=", 
    RowBox[{"Max", "[", 
     RowBox[{"energyData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"nElectrons", "/", "2"}]}], "]"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"cbm", "=", 
    RowBox[{"Min", "[", 
     RowBox[{"energyData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"nElectrons", "/", "2"}], "+", "1"}]}], "]"}], "]"}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Ef", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"vbm", "+", "cbm"}], ")"}], "/", "2"}]}]}]}]], "Input",
